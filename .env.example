# Memorizer docker compose settings — copy to .env (git-ignored) and edit.
#   cp .env.example .env
# Ready-made scenarios live in env/*.stack.env (e.g. cp env/psmon.stack.env .env)

# ── Scenario switches ────────────────────────────────────────────
# LLM provider preset → env/llm-<preset>.env : ollama | custom | openai
LLM_PRESET=ollama
# Optional services: ollama (local Ollama + model pull), tools (pgAdmin). Comma separated, empty = none.
COMPOSE_PROFILES=ollama

# App image: `docker compose up --build` builds from source and tags this name
MEMORIZER_IMAGE=psmon/mcp-memorizer:latest
MEMORIZER_PORT=5050
# Container user: app (default) | 0:0 (root — needed for Headless WebSearch dependency auto-install)
MEMORIZER_RUN_AS=app
CANONICAL_URL=http://localhost:5050

# WebSearch: Fetch | Headless
WEBSEARCH_MODE=Fetch
WEBSEARCH_INSTALL_BROWSER=false
WEBSEARCH_INSTALL_LINUX_DEPS=false

# ── Provider endpoints / models (only the active preset uses its own) ──
# ollama preset
#OLLAMA_EMBEDDING_MODEL=all-minilm:33m-l12-v2-fp16
#OLLAMA_LLM_MODEL=qwen2:0.5b
# custom preset — LLM devices (every feature uses A unless routed)
#LLM_A_URL=https://a1.webnori.com
#LLM_A_API_KEY=sk-lm-...
#LLM_B_URL=https://...
#LLM_B_API_KEY=sk-lm-...
# feature → device routing: EMBEDDING_* / LLM_* / LLM_EX_* / MULTIMODAL_*  (URL, API_KEY)
#MULTIMODAL_URL=${LLM_B_URL}
#MULTIMODAL_API_KEY=${LLM_B_API_KEY}
#CUSTOM_EMBEDDING_MODEL=text-embedding-all-minilm-l12-v2
#CUSTOM_LLM_MODEL=google/gemma-4-e4b
#CUSTOM_LLM_EX_MODEL=google/gemma-4-26b-a4b
#CUSTOM_MULTIMODAL_MODEL=qwen/qwen3-vl-8b
# openai preset
#OPENAI_API_KEY=sk-...

# ── Secrets (dev defaults shown — change for anything shared) ─────
POSTGRES_PASSWORD=postgres
NEO4J_PASSWORD=password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
MEMORIZER_API_KEY=your-api-key-here
OAUTH_ENABLED=true
OAUTH_SECRET_KEY=your-super-secret-key-at-least-32-characters-long
OAUTH_CLIENT_ID=chatgpt-mcp
OAUTH_CLIENT_SECRET=chatgpt-secret-key
