@* ShapeUp Tool Panel Partial View *@
<div class="tool-panel">
    <div class="tool-section">
        <div class="tool-section-title">Drawing Tools</div>
        <button class="tool-btn active" onclick="setTool('select')" id="tool-select">
            <i class="fas fa-mouse-pointer"></i> Select
        </button>
        <button class="tool-btn" onclick="setTool('rect')" id="tool-rect">
            <i class="fas fa-square"></i> Rectangle
        </button>
        <button class="tool-btn" onclick="setTool('circle')" id="tool-circle">
            <i class="fas fa-circle"></i> Circle
        </button>
        <button class="tool-btn" onclick="setTool('line')" id="tool-line">
            <i class="fas fa-minus"></i> Line
        </button>
        <button class="tool-btn" onclick="setTool('arrow')" id="tool-arrow">
            <i class="fas fa-arrow-right"></i> Arrow
        </button>
        <button class="tool-btn" onclick="setTool('text')" id="tool-text">
            <i class="fas fa-font"></i> Text
        </button>
        <button class="tool-btn" onclick="deleteSelected()">
            <i class="fas fa-trash"></i> Delete
        </button>
    </div>

    <div class="tool-section">
        <div class="tool-section-title">Board Templates</div>
        <button class="tool-btn board-template-btn" onclick="addBoardTemplate('problem')">
            <i class="fas fa-exclamation-circle color-problem"></i>
            <span class="template-name">Problem</span>
        </button>
        <button class="tool-btn board-template-btn" onclick="addBoardTemplate('breadboard')">
            <i class="fas fa-project-diagram color-breadboard"></i>
            <span class="template-name">Breadboard</span>
        </button>
        <button class="tool-btn board-template-btn" onclick="addBoardTemplate('fat-marker')">
            <i class="fas fa-paint-brush color-fatmarker"></i>
            <span class="template-name">Fat Marker</span>
        </button>
        <button class="tool-btn board-template-btn" onclick="addBoardTemplate('risk')">
            <i class="fas fa-exclamation-triangle color-risk"></i>
            <span class="template-name">Risk</span>
        </button>
        <button class="tool-btn board-template-btn" onclick="addBoardTemplate('pitch')">
            <i class="fas fa-bullseye color-pitch"></i>
            <span class="template-name">Pitch</span>
        </button>
    </div>

    <div class="tool-section">
        <div class="tool-section-title">Properties</div>
        <div class="mb-2">
            <label class="form-label small">Fill Color</label>
            <input type="color" id="fillColor" class="form-control form-control-sm" value="#ffffff" onchange="updateSelectedFill()">
        </div>
        <div class="mb-2">
            <label class="form-label small">Stroke Color</label>
            <input type="color" id="strokeColor" class="form-control form-control-sm" value="#333333" onchange="updateSelectedStroke()">
        </div>
        <div>
            <label class="form-label small">Stroke Width</label>
            <input type="range" id="strokeWidth" class="form-range" min="1" max="10" value="2" onchange="updateSelectedStrokeWidth()">
        </div>
    </div>

    <div class="tool-section" id="text-properties">
        <div class="tool-section-title">Text Properties</div>
        <div class="mb-2">
            <label class="form-label small">Text Color</label>
            <input type="color" id="textColor" class="form-control form-control-sm" value="#333333" onchange="updateSelectedTextColor()">
        </div>
        <div class="mb-2">
            <label class="form-label small">Text Size</label>
            <select id="textSize" class="form-select form-select-sm" onchange="updateSelectedTextSize()">
                <option value="32">H1</option>
                <option value="24">H2</option>
                <option value="18">H3</option>
                <option value="14" selected>Normal</option>
            </select>
        </div>
        <div class="mb-2">
            <label class="form-label small">Alignment</label>
            <div class="btn-group w-100" role="group">
                <button type="button" class="btn btn-outline-secondary btn-sm text-align-btn" onclick="updateTextAlign('left')" title="Left">
                    <i class="fas fa-align-left"></i>
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm text-align-btn active" onclick="updateTextAlign('center')" title="Center">
                    <i class="fas fa-align-center"></i>
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm text-align-btn" onclick="updateTextAlign('right')" title="Right">
                    <i class="fas fa-align-right"></i>
                </button>
            </div>
        </div>
        <div class="mb-2">
            <label class="form-label small">Style</label>
            <div class="btn-group w-100" role="group">
                <button type="button" class="btn btn-outline-secondary btn-sm text-style-btn" id="btn-bold" onclick="toggleTextStyle('bold')" title="Bold">
                    <i class="fas fa-bold"></i>
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm text-style-btn" id="btn-italic" onclick="toggleTextStyle('italic')" title="Italic">
                    <i class="fas fa-italic"></i>
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm text-style-btn" id="btn-underline" onclick="toggleTextStyle('underline')" title="Underline">
                    <i class="fas fa-underline"></i>
                </button>
            </div>
        </div>
        <div class="mb-2">
            <label class="form-label small">List</label>
            <div class="btn-group w-100" role="group">
                <button type="button" class="btn btn-outline-secondary btn-sm list-btn" id="btn-list-ol" onclick="insertList('ordered')" title="Numbered List">
                    <i class="fas fa-list-ol"></i>
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm list-btn" id="btn-list-ul" onclick="insertList('unordered')" title="Bullet List">
                    <i class="fas fa-list-ul"></i>
                </button>
            </div>
        </div>
    </div>
</div>
