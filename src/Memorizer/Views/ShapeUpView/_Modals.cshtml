@* ShapeUp Modals Partial View *@

<!-- Toast Container -->
<div id="toastContainer" class="toast-container"></div>

<!-- Progress Indicator (for Free Board generation) -->
<div id="progressIndicator" class="progress-indicator" style="display: none;">
    <div class="progress-icon">
        <i class="fas fa-circle-notch fa-spin"></i>
    </div>
    <div class="progress-text" id="progressText">처리 중...</div>
</div>

<!-- SVG Content Editor Modal -->
<div class="modal fade" id="svgContentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                <h5 class="modal-title">
                    <i class="fas fa-vector-square me-2"></i> SVG Box Content
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-7">
                        <div class="mb-3">
                            <label class="form-label">
                                <i class="fas fa-code me-1"></i> SVG Path Data
                                <small class="text-muted ms-2">(d attribute)</small>
                            </label>
                            <textarea class="form-control font-monospace" id="svg-path-input" rows="6" placeholder="M10 10 L90 10 L90 90 L10 90 Z"></textarea>
                            <small class="text-muted">SVG path 명령어: M(이동), L(선), C(곡선), A(호), Z(닫기)</small>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="form-label">Stroke Color</label>
                                <input type="color" class="form-control form-control-color w-100" id="svg-stroke-color" value="#333333">
                            </div>
                            <div class="col-6">
                                <label class="form-label">Stroke Width</label>
                                <input type="range" class="form-range" id="svg-stroke-width" min="1" max="10" value="2">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Quick Templates</label>
                            <div class="svg-template-grid">
                                <button class="btn btn-outline-secondary btn-sm svg-template-btn" onclick="setSvgTemplate('star')" title="Star">
                                    <svg viewBox="0 0 24 24" width="20" height="20"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="none" stroke="currentColor" stroke-width="2"/></svg>
                                </button>
                                <button class="btn btn-outline-secondary btn-sm svg-template-btn" onclick="setSvgTemplate('heart')" title="Heart">
                                    <svg viewBox="0 0 24 24" width="20" height="20"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" fill="none" stroke="currentColor" stroke-width="2"/></svg>
                                </button>
                                <button class="btn btn-outline-secondary btn-sm svg-template-btn" onclick="setSvgTemplate('lightning')" title="Lightning">
                                    <svg viewBox="0 0 24 24" width="20" height="20"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" fill="none" stroke="currentColor" stroke-width="2"/></svg>
                                </button>
                                <button class="btn btn-outline-secondary btn-sm svg-template-btn" onclick="setSvgTemplate('check')" title="Check">
                                    <svg viewBox="0 0 24 24" width="20" height="20"><path d="M20 6L9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2"/></svg>
                                </button>
                                <button class="btn btn-outline-secondary btn-sm svg-template-btn" onclick="setSvgTemplate('x')" title="X">
                                    <svg viewBox="0 0 24 24" width="20" height="20"><path d="M18 6L6 18M6 6l12 12" fill="none" stroke="currentColor" stroke-width="2"/></svg>
                                </button>
                                <button class="btn btn-outline-secondary btn-sm svg-template-btn" onclick="setSvgTemplate('box')" title="Box">
                                    <svg viewBox="0 0 24 24" width="20" height="20"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" fill="none" stroke="currentColor" stroke-width="2"/></svg>
                                </button>
                                <button class="btn btn-outline-secondary btn-sm svg-template-btn" onclick="setSvgTemplate('hexagon')" title="Hexagon">
                                    <svg viewBox="0 0 24 24" width="20" height="20"><path d="M21 16.5V7.5L12 2 3 7.5v9L12 22l9-5.5z" fill="none" stroke="currentColor" stroke-width="2"/></svg>
                                </button>
                                <button class="btn btn-outline-secondary btn-sm svg-template-btn" onclick="setSvgTemplate('diamond')" title="Diamond">
                                    <svg viewBox="0 0 24 24" width="20" height="20"><path d="M12 2L2 12l10 10 10-10L12 2z" fill="none" stroke="currentColor" stroke-width="2"/></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Preview</label>
                        <div class="svg-preview-container" id="svg-preview-container">
                            <svg id="svg-preview" viewBox="0 0 100 100" width="100%" height="200">
                                <rect x="0" y="0" width="100" height="100" fill="#f8f9fa" stroke="#dee2e6"/>
                                <path id="svg-preview-path" d="" fill="none" stroke="#333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <div class="svg-preview-error" id="svg-preview-error" style="display: none;">
                                <i class="fas fa-times-circle"></i>
                                <span>Invalid SVG Path</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="applySvgContent()">
                    <i class="fas fa-check me-1"></i> Apply
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Share Modal -->
<div class="modal fade" id="shareModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                <h5 class="modal-title">
                    <i class="fas fa-share-alt me-2"></i> Share Shape Up Board
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Title</label>
                    <input type="text" class="form-control" id="share-title" placeholder="Shape Up Board">
                </div>
                <div class="mb-3">
                    <label class="form-label">Share URL</label>
                    <div class="input-group">
                        <input type="text" class="form-control share-url-input" id="share-url" readonly>
                        <button class="btn btn-outline-primary" onclick="copyShareUrl()">
                            <i class="fas fa-copy"></i>
                        </button>
                    </div>
                </div>
                <div class="alert alert-success d-none" id="copy-success">
                    <i class="fas fa-check me-1"></i> Copied to clipboard!
                </div>
                <button class="btn btn-primary w-100" onclick="openSharePage()">
                    <i class="fas fa-external-link-alt me-1"></i> Open in New Tab
                </button>
            </div>
        </div>
    </div>
</div>
