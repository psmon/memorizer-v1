@* ShapeUp Property Popup Partial View *@
<div class="property-popup" id="property-popup">
    <div class="property-popup-header">
        <span class="property-popup-title">Properties</span>
        <button class="property-popup-close" onclick="hidePropertyPopup()">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <div class="property-popup-body">
        <!-- Shape Properties (Left Column) -->
        <div class="prop-section" id="popup-shape-props">
            <div class="prop-section-title">Shape</div>
            <div class="prop-row">
                <div class="prop-item">
                    <label>Fill Color</label>
                    <input type="color" id="popup-fillColor" class="form-control form-control-sm" value="#ffffff" onchange="updateSelectedFillFromPopup()">
                </div>
                <div class="prop-item">
                    <label>Stroke Color</label>
                    <input type="color" id="popup-strokeColor" class="form-control form-control-sm" value="#333333" onchange="updateSelectedStrokeFromPopup()">
                </div>
            </div>
            <div class="prop-row single">
                <div class="prop-item">
                    <label>Stroke Width</label>
                    <input type="range" id="popup-strokeWidth" class="form-range" min="1" max="10" value="2" onchange="updateSelectedStrokeWidthFromPopup()">
                </div>
            </div>
        </div>

        <!-- Text Properties (Right Column) -->
        <div class="prop-section" id="popup-text-props">
            <div class="prop-section-title">Text</div>
            <div class="prop-row">
                <div class="prop-item">
                    <label>Color</label>
                    <input type="color" id="popup-textColor" class="form-control form-control-sm" value="#333333" onchange="updateSelectedTextColorFromPopup()">
                </div>
                <div class="prop-item">
                    <label>Size</label>
                    <select id="popup-textSize" class="form-select form-select-sm" onchange="updateSelectedTextSizeFromPopup()">
                        <option value="32">H1</option>
                        <option value="24">H2</option>
                        <option value="18">H3</option>
                        <option value="14" selected>Normal</option>
                    </select>
                </div>
            </div>
            <div class="prop-row">
                <div class="prop-item">
                    <label>Align</label>
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-secondary btn-sm popup-text-align-btn" onclick="updateTextAlignFromPopup('left')" title="Left">
                            <i class="fas fa-align-left"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm popup-text-align-btn active" onclick="updateTextAlignFromPopup('center')" title="Center">
                            <i class="fas fa-align-center"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm popup-text-align-btn" onclick="updateTextAlignFromPopup('right')" title="Right">
                            <i class="fas fa-align-right"></i>
                        </button>
                    </div>
                </div>
                <div class="prop-item">
                    <label>Style</label>
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-secondary btn-sm popup-text-style-btn" id="popup-btn-bold" onclick="toggleTextStyleFromPopup('bold')" title="Bold">
                            <i class="fas fa-bold"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm popup-text-style-btn" id="popup-btn-italic" onclick="toggleTextStyleFromPopup('italic')" title="Italic">
                            <i class="fas fa-italic"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm popup-text-style-btn" id="popup-btn-underline" onclick="toggleTextStyleFromPopup('underline')" title="Underline">
                            <i class="fas fa-underline"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="prop-row single">
                <div class="prop-item">
                    <label>List</label>
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-secondary btn-sm popup-list-btn" id="popup-btn-list-ol" onclick="insertListFromPopup('ordered')" title="Numbered List">
                            <i class="fas fa-list-ol"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm popup-list-btn" id="popup-btn-list-ul" onclick="insertListFromPopup('unordered')" title="Bullet List">
                            <i class="fas fa-list-ul"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
