                'breadboard': '#00c6ff',
                'fat-marker': '#11998e',
                'risk': '#f093fb',
                'pitch': '#ff6b6b'
            };

            const color = colors[type] || '#667eea';
            const centerX = (canvas.width || 800) / 2 - 200;
