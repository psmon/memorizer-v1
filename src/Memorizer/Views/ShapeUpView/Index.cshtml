        // Helper: Create squiggle line
        function createSquiggle(el) {
            const y = el.y || 0;
            const width = el.width || 100;
            let path = `M ${el.x || 0} ${y}`;
            for (let i = 0; i < width; i += 10) {
                path += ` Q ${(el.x || 0) + i + 5} ${y + (i % 20 === 0 ? -5 : 5)}, ${(el.x || 0) + i + 10} ${y}`;
            }
            return new fabric.Path(path, {
                stroke: '#333',
                strokeWidth: 3,
                fill: ''
            });
        }

