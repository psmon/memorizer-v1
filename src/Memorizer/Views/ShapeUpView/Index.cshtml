@{
    ViewData["Title"] = "Shape Up Whiteboard";
    Layout = "_Layout";
    ViewBag.Controller = "ShapeUpView";
}

@section Styles {
    <link rel="stylesheet" href="~/css/shapeup.css" />
}

<div class="shapeup-page">
    @* Modals, Toast Container, Progress Indicator *@
    @await Html.PartialAsync("_Modals")

    <!-- Header -->
    <div class="shapeup-header">
        <h1>
            <i class="fas fa-chalkboard me-2"></i>
            Shape Up Whiteboard
        </h1>
        <div class="header-buttons">
            <button class="btn-header" onclick="clearCanvas()">
                <i class="fas fa-trash-alt me-1"></i> Clear
            </button>
            <button class="btn-header" onclick="exportToPNG()">
                <i class="fas fa-image me-1"></i> PNG
            </button>
            <button class="btn-header" onclick="exportToSVG()">
                <i class="fas fa-file-code me-1"></i> SVG
            </button>
            <button class="btn-header" onclick="shareBoard()">
                <i class="fas fa-share-alt me-1"></i> Share
            </button>
        </div>
    </div>

    <div class="shapeup-container">
        @* Tool Panel *@
        @await Html.PartialAsync("_ToolPanel")

        @* Canvas Area *@
        @await Html.PartialAsync("_Canvas")
    </div>
</div>

@* Context Menu *@
@await Html.PartialAsync("_ContextMenu")

@* Property Popup *@
@await Html.PartialAsync("_PropertyPopup")

@section Scripts {
    <!-- Fabric.js 5.3.1 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/fabric.js/5.3.1/fabric.min.js"></script>
    <!-- FileSaver.js for download -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

    <!-- ShapeUp JavaScript -->
    <script src="~/js/shapeup.js"></script>
    <script src="~/js/shapeup-templates.js"></script>
}
