                        <button type="button" class="btn btn-outline-secondary btn-sm popup-text-style-btn" id="popup-btn-bold" onclick="toggleTextStyleFromPopup('bold')" title="Bold">
                            <i class="fas fa-bold"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm popup-text-style-btn" id="popup-btn-italic" onclick="toggleTextStyleFromPopup('italic')" title="Italic">
                            <i class="fas fa-italic"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm popup-text-style-btn" id="popup-btn-underline" onclick="toggleTextStyleFromPopup('underline')" title="Underline">
                            <i class="fas fa-underline"></i>
