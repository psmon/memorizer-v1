@{
    ViewData["Title"] = "PRD 분석 결과";
    Layout = "_Layout";
    ViewBag.Controller = "PrdMakerView";
}

@section Styles {
    <link rel="stylesheet" href="~/css/markdown-styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">
    <style>
        .prd-share-page {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            min-height: 100vh;
            padding: 20px 0;
        }

        .page-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .page-header h1 {
            color: #212529;
        }

        .share-info {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .info-badge {
            background: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.9rem;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .result-section {
            background: white;
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            border: 1px solid #e9ecef;
        }

        .result-section.prd {
            border-top: 4px solid #667eea;
        }

        .result-section.event-storming {
            border-top: 4px solid #00c6ff;
        }

        .result-section.discussion {
            border-top: 4px solid #f093fb;
        }

        .result-section.example-mapping {
            border-top: 4px solid #11998e;
        }

        .result-section.refined-prd {
            border-top: 4px solid #ff6b6b;
        }

        .result-section.bounded-context {
            border-top: 4px solid #6f42c1;
        }

        .section-title {
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .section-content {
            background: #f8f9fa;
            border-radius: 12px;
            padding: 20px;
            border: 1px solid #e9ecef;
        }

        .prd-content {
            white-space: pre-wrap;
            font-family: inherit;
            line-height: 1.6;
        }

        .markdown-content {
            color: #212529;
        }

        .markdown-content h3 {
            color: #667eea;
            border-bottom: 1px solid #e9ecef;
            padding-bottom: 10px;
        }

        /* Table responsive wrapper */
        .table-responsive-wrapper {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            margin: 15px 0;
        }

        .markdown-content table {
            width: 100%;
            min-width: 500px;
            border-collapse: collapse;
            table-layout: auto;
        }

        .markdown-content th,
        .markdown-content td {
            border: 1px solid #dee2e6;
            padding: 12px 15px;
            text-align: left;
            min-width: 120px;
            word-wrap: break-word;
            line-height: 1.5;
        }

        .markdown-content th {
            background: #f8f9fa;
            font-weight: 600;
            white-space: nowrap;
        }

        .markdown-content td {
            vertical-align: top;
        }

        /* Ensure minimum readable width - at least 15 characters per line */
        .markdown-content td:first-child {
            min-width: 80px;
        }

        .markdown-content td:not(:first-child) {
            min-width: 180px;
        }

        /* Mobile specific adjustments */
        @@media (max-width: 768px) {
            .markdown-content table {
                min-width: 600px;
                font-size: 0.9rem;
            }

            .markdown-content th,
            .markdown-content td {
                padding: 10px 12px;
            }

            .table-responsive-wrapper {
                margin: 10px -15px;
                padding: 0 15px;
            }
        }

        .mermaid-container {
            background: white;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 20px;
            margin: 16px 0;
            text-align: center;
        }

        .markdown-content pre {
            position: relative;
            background: #1e1e1e !important;
            border: 1px solid #333;
            border-radius: 8px;
            margin: 16px 0;
            padding: 0;
            overflow: hidden;
        }

        .markdown-content pre code {
            display: block;
            padding: 16px;
            padding-top: 40px;
            overflow-x: auto;
            background: #1e1e1e !important;
            color: #d4d4d4 !important;
        }

        .code-block-header {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 6px 12px;
            background: #2d2d2d;
            border-bottom: 1px solid #444;
            font-size: 0.75rem;
        }

        .code-language {
            color: #9cdcfe;
            font-weight: 600;
            text-transform: uppercase;
        }

        .loading-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 60px;
        }

        .error-container {
            text-align: center;
            padding: 60px;
            color: #dc3545;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #667eea;
            text-decoration: none;
            margin-bottom: 20px;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        .btn-wireframe {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            border: none;
            color: white;
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-wireframe:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(17, 153, 142, 0.4);
            color: white;
        }

        .btn-wireframe:disabled {
            background: #adb5bd;
            cursor: not-allowed;
        }

        .loading-spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top-color: white;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }

        .wireframe-action-section {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 30px;
            padding: 20px;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border-radius: 12px;
        }
    </style>
}

<div class="prd-share-page">
    <div class="container-fluid py-4">
        <a href="/ui/prd/shares" class="back-link">
            <i class="fas fa-arrow-left"></i> 목록으로 돌아가기
        </a>

        <div id="loadingContainer" class="loading-container">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3 text-muted">분석 결과를 불러오는 중...</p>
        </div>

        <div id="errorContainer" class="error-container" style="display: none;">
            <i class="fas fa-exclamation-circle fa-3x mb-3"></i>
            <h3>결과를 찾을 수 없습니다</h3>
            <p>요청하신 PRD 분석 결과가 존재하지 않거나 만료되었습니다.</p>
            <a href="/ui/prd" class="btn btn-primary mt-3">
                <i class="fas fa-plus me-1"></i> 새 분석 시작
            </a>
        </div>

        <div id="contentContainer" style="display: none;">
            <div class="page-header">
                <h1 class="h2" id="pageTitle">
                    <i class="fas fa-file-alt me-2" style="color: #667eea;"></i>
                    PRD 분석 결과
                </h1>
                <div class="share-info">
                    <span class="info-badge">
                        <i class="fas fa-calendar-alt me-1"></i>
                        <span id="createdAt"></span>
                    </span>
                    <span class="info-badge">
                        <i class="fas fa-link me-1"></i>
                        <span id="shortCode">@ViewBag.ShortCode</span>
                    </span>
                </div>
            </div>

            <!-- Original PRD -->
            <div class="result-section prd">
                <div class="section-title">
                    <i class="fas fa-edit" style="color: #667eea;"></i>
                    원본 PRD
                </div>
                <div class="section-content">
                    <div class="prd-content" id="prdContent"></div>
                </div>
            </div>

            <!-- Event Storming -->
            <div class="result-section event-storming">
                <div class="section-title">
                    <i class="fas fa-bolt" style="color: #00c6ff;"></i>
                    이벤트 스토밍
                </div>
                <div class="section-content">
                    <div class="markdown-content" id="eventStormingContent"></div>
                </div>
            </div>

            <!-- Discussion -->
            <div class="result-section discussion" id="discussionSection" style="display: none;">
                <div class="section-title">
                    <i class="fas fa-users" style="color: #f093fb;"></i>
                    예제 맵핑 토론
                </div>
                <div class="section-content">
                    <div class="markdown-content" id="discussionContent"></div>
                </div>
            </div>

            <!-- Example Mapping -->
            <div class="result-section example-mapping" id="exampleMappingSection" style="display: none;">
                <div class="section-title">
                    <i class="fas fa-map" style="color: #11998e;"></i>
                    예제 맵핑 결과
                </div>
                <div class="section-content">
                    <div class="markdown-content" id="exampleMappingContent"></div>
                </div>
            </div>

            <!-- Refined PRD -->
            <div class="result-section refined-prd" id="refinedPrdSection" style="display: none;">
                <div class="section-title">
                    <i class="fas fa-file-signature" style="color: #ff6b6b;"></i>
                    보완된 PRD
                </div>
                <div class="section-content">
                    <div class="markdown-content" id="refinedPrdContent"></div>
                </div>
            </div>

            <!-- Bounded Context -->
            <div class="result-section bounded-context" id="boundedContextSection" style="display: none;">
                <div class="section-title">
                    <i class="fas fa-project-diagram" style="color: #6f42c1;"></i>
                    바운디드 컨텍스트 정의
                </div>
                <div class="section-content">
                    <div class="markdown-content" id="boundedContextContent"></div>
                </div>
            </div>

            <!-- Wireframe Action Section (shown when refinedPrdResult exists) -->
            <div class="wireframe-action-section" id="wireframeActionSection" style="display: none;">
                <button class="btn btn-wireframe" id="btnWireframe" onclick="generateWireframe()">
                    <i class="fas fa-palette me-2"></i> ShapeUp으로 와이어프레임 생성
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/mermaid@10.6.1/dist/mermaid.min.js"></script>

    <script>
        const shortCode = '@ViewBag.ShortCode';

        // Store data for wireframe generation
        let sharedData = {
            refinedPrdResult: '',
            eventStormingResult: '',
            exampleMappingResult: ''
        };

        document.addEventListener('DOMContentLoaded', async function() {
            if (typeof mermaid !== 'undefined') {
                mermaid.initialize({
                    startOnLoad: false,
                    theme: 'default',
                    securityLevel: 'loose'
                });
            }

            await loadSharedPrd();
        });

        async function loadSharedPrd() {
            try {
                const response = await fetch(`/api/prd/share/${shortCode}`);

                if (!response.ok) {
                    throw new Error('Not found');
                }

                const data = await response.json();

                document.getElementById('loadingContainer').style.display = 'none';
                document.getElementById('contentContainer').style.display = 'block';

                document.getElementById('pageTitle').innerHTML = `
                    <i class="fas fa-file-alt me-2" style="color: #667eea;"></i>
                    ${escapeHtml(data.content.title)}
                `;

                document.getElementById('createdAt').textContent = new Date(data.createdAt).toLocaleDateString('ko-KR', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                });

                document.getElementById('prdContent').textContent = data.content.prdContent;

                renderMarkdown('eventStormingContent', data.content.eventStormingResult);
                sharedData.eventStormingResult = data.content.eventStormingResult || '';

                if (data.content.discussionResult) {
                    document.getElementById('discussionSection').style.display = 'block';
                    renderMarkdown('discussionContent', data.content.discussionResult);
                }

                if (data.content.exampleMappingResult) {
                    document.getElementById('exampleMappingSection').style.display = 'block';
                    renderMarkdown('exampleMappingContent', data.content.exampleMappingResult);
                    sharedData.exampleMappingResult = data.content.exampleMappingResult;
                }

                if (data.content.refinedPrdResult) {
                    document.getElementById('refinedPrdSection').style.display = 'block';
                    renderMarkdown('refinedPrdContent', data.content.refinedPrdResult);
                    sharedData.refinedPrdResult = data.content.refinedPrdResult;

                    // Show wireframe action button when refinedPrdResult exists
                    document.getElementById('wireframeActionSection').style.display = 'flex';
                }

                if (data.content.boundedContextResult) {
                    document.getElementById('boundedContextSection').style.display = 'block';
                    renderMarkdown('boundedContextContent', data.content.boundedContextResult);
                }
            } catch (error) {
                console.error('Load error:', error);
                document.getElementById('loadingContainer').style.display = 'none';
                document.getElementById('errorContainer').style.display = 'block';
            }
        }

        function renderMarkdown(elementId, content) {
            const element = document.getElementById(elementId);

            if (typeof marked !== 'undefined') {
                element.innerHTML = marked.parse(content);
            } else {
                element.innerHTML = escapeHtml(content).replace(/\n/g, '<br>');
            }

            processCodeBlocks(element);
            wrapTablesForResponsive(element);

            if (typeof hljs !== 'undefined') {
                element.querySelectorAll('pre code').forEach((block) => {
                    if (!block.classList.contains('language-mermaid')) {
                        hljs.highlightElement(block);
                    }
                });
            }

            renderMermaidInContent(element);
        }

        function wrapTablesForResponsive(container) {
            container.querySelectorAll('table').forEach((table) => {
                if (table.parentElement.classList.contains('table-responsive-wrapper')) return;

                const wrapper = document.createElement('div');
                wrapper.className = 'table-responsive-wrapper';
                table.parentNode.insertBefore(wrapper, table);
                wrapper.appendChild(table);
            });
        }

        function processCodeBlocks(container) {
            container.querySelectorAll('pre > code').forEach((codeBlock) => {
                const pre = codeBlock.parentElement;
                if (pre.querySelector('.code-block-header')) return;

                let language = 'code';
                const classList = codeBlock.className.split(' ');
                for (const cls of classList) {
                    if (cls.startsWith('language-')) {
                        language = cls.replace('language-', '');
                        break;
                    }
                }

                const header = document.createElement('div');
                header.className = 'code-block-header';
                header.innerHTML = `<span class="code-language">${escapeHtml(language)}</span>`;
                pre.insertBefore(header, pre.firstChild);
            });
        }

        async function renderMermaidInContent(container) {
            if (typeof mermaid === 'undefined') return;

            const mermaidBlocks = container.querySelectorAll('pre > code.language-mermaid');

            for (const codeBlock of mermaidBlocks) {
                const pre = codeBlock.parentElement;
                const mermaidCode = codeBlock.textContent.trim();

                const mermaidContainer = document.createElement('div');
                mermaidContainer.className = 'mermaid-container';

                const mermaidDiv = document.createElement('div');
                mermaidDiv.className = 'mermaid';
                mermaidDiv.textContent = mermaidCode;
                mermaidContainer.appendChild(mermaidDiv);

                pre.parentNode.replaceChild(mermaidContainer, pre);

                try {
                    await mermaid.run({ nodes: [mermaidDiv] });
                } catch (error) {
                    console.error('Mermaid render error:', error);
                }
            }
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Generate wireframe using ShapeUp
        function generateWireframe() {
            if (!sharedData.refinedPrdResult) {
                alert('보완된 PRD가 없어 와이어프레임을 생성할 수 없습니다.');
                return;
            }

            // Build wireframe prompt from PRD data
            const wireframePrompt = buildWireframePrompt();

            // Store in sessionStorage for ShapeUp to read
            sessionStorage.setItem('prdWireframePrompt', wireframePrompt);

            // Navigate to ShapeUp with prdWireframe flag
            window.location.href = '/ui/shapeup?prdWireframe=true';
        }

        function buildWireframePrompt() {
            return `PRD 기반 UI 와이어프레임을 시각화해주세요.

## 보완된 PRD
${sharedData.refinedPrdResult.substring(0, 2000)}${sharedData.refinedPrdResult.length > 2000 ? '...' : ''}

## 이벤트 스토밍 결과 (요약)
${sharedData.eventStormingResult.substring(0, 1000)}${sharedData.eventStormingResult.length > 1000 ? '...' : ''}

## 예제 맵핑 결과 (요약)
${sharedData.exampleMappingResult.substring(0, 1000)}${sharedData.exampleMappingResult.length > 1000 ? '...' : ''}

## 요청사항
위 PRD를 기반으로 주요 화면의 와이어프레임을 그려주세요:
1. 메인 페이지 레이아웃 (헤더, 네비게이션, 메인 콘텐츠 영역)
2. 핵심 기능별 화면 구성
3. 사용자 플로우를 화살표로 연결
4. 주요 UI 컴포넌트 (버튼, 폼, 목록 등) 배치

Frame과 Shape를 활용하여 화면 구조를 명확하게 표현하고,
텍스트로 각 영역의 기능을 설명해주세요.`;
        }
    </script>
}
