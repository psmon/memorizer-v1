                    renderMarkdown('exampleMapping', exampleMappingResult);
                });

                updateStatus('exampleMapping', 'completed');
                actions.style.display = 'flex';

                await renderMermaidInElement(markdown);
            } catch (error) {
                if (error.name === 'AbortError') {
                    updateStatus('exampleMapping', 'pending');
                } else {
                    console.error('Example Mapping error:', error);
                    markdown.innerHTML = '<p class="text-danger"><i class="fas fa-exclamation-circle me-1"></i> 예제 맵핑 생성 중 오류가 발생했습니다.</p>';
                    updateStatus('exampleMapping', 'error');
                }
            } finally {
                setButtonState('btnStep3', false);
                stopBtn.style.display = 'none';
            }
        }

        async function startRefinedPrd() {
            if (!exampleMappingResult) return;

            const stopBtn = document.getElementById('btnStopRefinedPrd');
            const placeholder = document.getElementById('refinedPrdPlaceholder');
            const markdown = document.getElementById('refinedPrdMarkdown');
            const shareSection = document.getElementById('shareSection');

            setButtonState('btnStep4', true);
            stopBtn.style.display = 'inline-block';
            placeholder.style.display = 'none';
            markdown.style.display = 'block';
            markdown.innerHTML = '';
            shareSection.style.display = 'none';
            refinedPrdResult = '';

            updateStepProgress(5);
            updateStatus('refinedPrd', 'in-progress');

            abortControllers.refinedPrd = new AbortController();

            try {
                const response = await fetch('/api/prd/refined-prd', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ prdContent, eventStormingResult, discussionResult, exampleMappingResult }),
                    signal: abortControllers.refinedPrd.signal
                });

                if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);

                await streamResponse(response, (content) => {
                    refinedPrdResult += content;
                    renderMarkdown('refinedPrd', refinedPrdResult);
                });

                updateStatus('refinedPrd', 'completed');
                shareSection.style.display = 'flex';

                await renderMermaidInElement(markdown);
            } catch (error) {
                if (error.name === 'AbortError') {
                    updateStatus('refinedPrd', 'pending');
                } else {
                    console.error('Refined PRD error:', error);
                    markdown.innerHTML = '<p class="text-danger"><i class="fas fa-exclamation-circle me-1"></i> PRD 생성 중 오류가 발생했습니다.</p>';
                    updateStatus('refinedPrd', 'error');
                }
            } finally {
                setButtonState('btnStep4', false);
                stopBtn.style.display = 'none';
            }
        }

        function resetAllResults() {
            eventStormingResult = '';
            discussionResult = '';
            exampleMappingResult = '';
            refinedPrdResult = '';

            ['eventStorming', 'discussion', 'exampleMapping', 'refinedPrd'].forEach(section => {
                document.getElementById(`${section}Placeholder`).style.display = 'block';
                document.getElementById(`${section}Markdown`).style.display = 'none';
                document.getElementById(`${section}Markdown`).innerHTML = '';
                updateStatus(section, 'pending');
            });

            document.getElementById('eventStormingActions').style.display = 'none';
            document.getElementById('discussionActions').style.display = 'none';
            document.getElementById('exampleMappingActions').style.display = 'none';
            document.getElementById('shareSection').style.display = 'none';

            updateStepProgress(1);
        }

        function stopGeneration(type) {
            if (abortControllers[type]) {
                abortControllers[type].abort();
            }
        }

        async function streamResponse(response, onChunk) {
            const reader = response.body.getReader();
            const decoder = new TextDecoder();
            let buffer = '';

            while (true) {
                const { done, value } = await reader.read();
                if (done) break;

                buffer += decoder.decode(value, { stream: true });
                const lines = buffer.split('\n');
                buffer = lines.pop() || '';

                for (const line of lines) {
                    if (line.startsWith('data: ')) {
                        try {
                            const data = JSON.parse(line.substring(6));
                            if (data.content) {
                                onChunk(data.content);
                            }
                        } catch (e) {}
                    }
                }
            }
        }

        function renderMarkdown(section, content) {
            const markdown = document.getElementById(`${section}Markdown`);
            if (typeof marked !== 'undefined') {
                markdown.innerHTML = marked.parse(content);
            } else {
                markdown.innerHTML = escapeHtml(content).replace(/\n/g, '<br>');
            }
            processCodeBlocks(markdown);
            wrapTablesForResponsive(markdown);
            if (typeof hljs !== 'undefined') {
                markdown.querySelectorAll('pre code').forEach((block) => {
                    if (!block.classList.contains('language-mermaid')) {
                        hljs.highlightElement(block);
                    }
                });
            }
        }

        function wrapTablesForResponsive(container) {
            container.querySelectorAll('table').forEach((table) => {
                if (table.parentElement.classList.contains('table-responsive-wrapper')) return;

                const wrapper = document.createElement('div');
                wrapper.className = 'table-responsive-wrapper';
                table.parentNode.insertBefore(wrapper, table);
                wrapper.appendChild(table);
            });
        }

        async function renderMermaidInElement(container) {
            if (typeof mermaid === 'undefined') return;

            const mermaidBlocks = container.querySelectorAll('pre > code.language-mermaid');

            for (const codeBlock of mermaidBlocks) {
                const pre = codeBlock.parentElement;
                const mermaidCode = codeBlock.textContent.trim();

                const mermaidContainer = document.createElement('div');
                mermaidContainer.className = 'mermaid-container';

                const mermaidDiv = document.createElement('div');
                mermaidDiv.className = 'mermaid';
                mermaidDiv.textContent = mermaidCode;
                mermaidContainer.appendChild(mermaidDiv);

                pre.parentNode.replaceChild(mermaidContainer, pre);

                try {
                    await mermaid.run({ nodes: [mermaidDiv] });
                } catch (error) {
                    console.error('Mermaid render error:', error);
                    mermaidContainer.innerHTML = `<div class="alert alert-warning mb-0"><i class="fas fa-exclamation-triangle me-2"></i>다이어그램 렌더링 실패</div>`;
                }
            }
        }

        function processCodeBlocks(container) {
            container.querySelectorAll('pre > code').forEach((codeBlock) => {
                const pre = codeBlock.parentElement;
                if (pre.querySelector('.code-block-header')) return;
                if (codeBlock.classList.contains('language-mermaid')) return;

                let language = 'code';
                for (const cls of codeBlock.className.split(' ')) {
                    if (cls.startsWith('language-')) {
                        language = cls.replace('language-', '');
                        break;
                    }
                }

                const header = document.createElement('div');
                header.className = 'code-block-header';
                header.innerHTML = `<span class="code-language">${escapeHtml(language)}</span><button class="btn btn-sm btn-outline-light" onclick="copyCodeBlock(this)"><i class="fas fa-copy"></i></button>`;
                pre.insertBefore(header, pre.firstChild);
            });
        }

        function copyCodeBlock(button) {
            const pre = button.closest('pre');
            const code = pre.querySelector('code');
            navigator.clipboard.writeText(code.textContent).then(() => {
                button.innerHTML = '<i class="fas fa-check"></i>';
                setTimeout(() => { button.innerHTML = '<i class="fas fa-copy"></i>'; }, 2000);
            });
        }

        function copyRefinedPrdToInput() {
            if (refinedPrdResult) {
                document.getElementById('prdInput').value = refinedPrdResult;
                window.scrollTo({ top: 0, behavior: 'smooth' });
                resetAllResults();
            }
        }

        async function sharePrd() {
            try {
                // Show loading indicator
                const shareButtons = document.querySelectorAll('.btn-share');
                shareButtons.forEach(btn => {
                    btn.disabled = true;
                    btn.innerHTML = '<span class="loading-spinner"></span> 제목 생성 중...';
                });

                // Generate title using LLM
                let title = 'PRD 분석';
                try {
                    const titleResponse = await fetch('/api/prd/generate-title', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ prdContent })
                    });

                    if (titleResponse.ok) {
                        const titleData = await titleResponse.json();
                        title = titleData.title || 'PRD 분석';
                    }
                } catch (titleError) {
                    console.warn('Title generation failed, using default:', titleError);
                }

                // Update button text
                shareButtons.forEach(btn => {
                    btn.innerHTML = '<span class="loading-spinner"></span> 공유 링크 생성 중...';
                });

                // Create share link
                const response = await fetch('/api/prd/share', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        title,
                        prdContent,
                        eventStormingResult,
                        discussionResult,
                        exampleMappingResult,
                        refinedPrdResult
                    })
                });

                if (!response.ok) throw new Error('Failed to create share link');

                const data = await response.json();
                const shareUrl = `${window.location.origin}/ui/prd/share/${data.shortCode}`;

                document.getElementById('shareTitle').value = title;
                document.getElementById('shareUrlInput').value = shareUrl;
                new bootstrap.Modal(document.getElementById('shareModal')).show();
            } catch (error) {
                console.error('Share error:', error);
                alert('공유 링크 생성에 실패했습니다.');
            } finally {
                // Restore buttons
                const shareButtons = document.querySelectorAll('.btn-share');
                shareButtons.forEach(btn => {
                    btn.disabled = false;
                    if (btn.closest('#exampleMappingActions')) {
                        btn.innerHTML = '<i class="fas fa-share-alt me-1"></i> 여기까지 공유하기';
                    } else {
                        btn.innerHTML = '<i class="fas fa-share-alt me-1"></i> 결과 공유하기';
                    }
                });
            }
        }

        function copyShareUrl() {
            const input = document.getElementById('shareUrlInput');
            navigator.clipboard.writeText(input.value).then(() => {
                const success = document.getElementById('copySuccess');
                success.classList.remove('d-none');
                setTimeout(() => success.classList.add('d-none'), 3000);
            });
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>
}
