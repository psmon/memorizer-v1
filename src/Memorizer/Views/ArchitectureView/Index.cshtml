</div>

<!-- Share Modal -->
<div class="modal fade" id="shareModal" tabindex="-1" aria-labelledby="shareModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="shareModalLabel">
                    <i class="fas fa-share-alt me-2"></i> Share Architecture
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">Share this architecture design with others:</p>
                <div class="input-group">
                    <input type="text" class="form-control" id="shareUrlInput" readonly>
                    <button class="btn btn-outline-primary" type="button" onclick="copyShareUrl()">
                        <i class="fas fa-copy"></i>
                    </button>
                </div>
                <small class="text-success d-none mt-2" id="copySuccess">
                    <i class="fas fa-check me-1"></i> Copied to clipboard!
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/mermaid@10.6.1/dist/mermaid.min.js"></script>

    <script>
        // State
        let selectedMemoryA = null;
        let selectedMemoryB = null;
        let currentIdea = '';
        let currentArchitecture = '';
        let isGenerating = false;
        let abortController = null;

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize mermaid
            if (typeof mermaid !== 'undefined') {
                mermaid.initialize({
                    startOnLoad: false,
                    theme: 'default',
                    securityLevel: 'loose'
                });

                // Render about section mermaid diagram
                const aboutMermaid = document.getElementById('aboutMermaid');
                if (aboutMermaid) {
                    mermaid.run({ nodes: [aboutMermaid] });
                }
            }

            // Setup similarity sliders
            setupSlider('A');
            setupSlider('B');

            // Setup search input events
            setupSearchInput('A');
            setupSearchInput('B');
        });

        function setupSlider(side) {
            const slider = document.getElementById(`similarity${side}`);
            const value = document.getElementById(`similarityValue${side}`);
            slider.addEventListener('input', function() {
                value.textContent = parseFloat(this.value).toFixed(2);
            });
        }

        function setupSearchInput(side) {
            const input = document.getElementById(`search${side}`);
            const results = document.getElementById(`results${side}`);

            input.addEventListener('input', debounce(function() {
                if (this.value.length >= 2) {
                    searchMemories(side);
                } else {
                    results.classList.remove('show');
                }
            }, 300));

            input.addEventListener('focus', function() {
                if (results.children.length > 0) {
                    results.classList.add('show');
                }
            });

            document.addEventListener('click', function(e) {
                if (!input.contains(e.target) && !results.contains(e.target)) {
                    results.classList.remove('show');
                }
            });
        }

        function debounce(func, wait) {
            let timeout;
            return function executedFunction(...args) {
                const later = () => {
                    clearTimeout(timeout);
                    func.apply(this, args);
                };
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
            };
        }

        async function searchMemories(side) {
            const query = document.getElementById(`search${side}`).value.trim();
            if (!query) return;

            const similarity = document.getElementById(`similarity${side}`).value;
            const resultsDiv = document.getElementById(`results${side}`);

            try {
                const response = await fetch(`/api/memory/search?query=${encodeURIComponent(query)}&minSimilarity=${similarity}&limit=10`);
                const results = await response.json();

                resultsDiv.innerHTML = '';
                if (results.length === 0) {
                    resultsDiv.innerHTML = '<div class="search-result-item text-muted">No results found</div>';
                } else {
                    results.forEach(memory => {
                        const item = document.createElement('div');
                        item.className = 'search-result-item';
                        item.innerHTML = `
                            <div class="search-result-title">${escapeHtml(memory.title || 'Untitled')}</div>
                            <div class="search-result-type">${escapeHtml(memory.type)}</div>
                        `;
                        item.onclick = () => selectMemory(side, memory);
                        resultsDiv.appendChild(item);
                    });
                }
                resultsDiv.classList.add('show');
            } catch (error) {
                console.error('Search error:', error);
            }
        }

        async function getRandomMemory(side) {
            try {
                let excludeId = null;
                if (side === 'B' && selectedMemoryA) {
                    excludeId = selectedMemoryA.id;
                } else if (side === 'A' && selectedMemoryB) {
                    excludeId = selectedMemoryB.id;
                }

                const url = excludeId
                    ? `/api/architecture/random?excludeId=${excludeId}`
                    : '/api/architecture/random';

                const response = await fetch(url);
                if (!response.ok) throw new Error('Failed to get random memory');

                const memory = await response.json();
                selectMemory(side, memory);
            } catch (error) {
                console.error('Random memory error:', error);
                alert('Failed to get random memory. Please try again.');
            }
        }

        function selectMemory(side, memory) {
            if (side === 'A') {
                selectedMemoryA = memory;
            } else {
                selectedMemoryB = memory;
            }

            // Update preview
            const preview = document.getElementById(`preview${side}`);
            preview.classList.remove('empty');
            preview.innerHTML = `
                <div class="memory-type">${escapeHtml(memory.type)}</div>
                <div class="memory-title">${escapeHtml(memory.title || 'Untitled')}</div>
                <div class="memory-content">${escapeHtml(truncateText(memory.text, 300))}</div>
                ${memory.tags && memory.tags.length > 0 ? `
                    <div class="memory-tags">
                        ${memory.tags.slice(0, 5).map(tag => `<span class="badge">${escapeHtml(tag)}</span>`).join('')}
                    </div>
                ` : ''}
            `;

            // Hide results dropdown
            document.getElementById(`results${side}`).classList.remove('show');

            // Update button states
            updateButtonStates();
        }

        function updateButtonStates() {
            const canGenerateIdea = selectedMemoryA && selectedMemoryB;
            document.getElementById('btnGenerateIdea').disabled = !canGenerateIdea;

            const canGenerateArch = canGenerateIdea && currentIdea.trim().length > 0;
            document.getElementById('btnGenerateArch').disabled = !canGenerateArch;
        }

        async function generateIdea() {
            if (!selectedMemoryA || !selectedMemoryB) return;

            const btn = document.getElementById('btnGenerateIdea');
            const placeholder = document.getElementById('ideaPlaceholder');
            const markdown = document.getElementById('ideaMarkdown');

            btn.innerHTML = '<span class="loading-spinner"></span> Generating...';
            btn.disabled = true;
            placeholder.style.display = 'none';
            markdown.style.display = 'block';
            markdown.innerHTML = '';
            currentIdea = '';

            try {
                const response = await fetch('/api/architecture/generate-idea', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        memory1Id: selectedMemoryA.id,
                        memory2Id: selectedMemoryB.id
                    })
                });

                await streamResponse(response, (content) => {
                    currentIdea += content;
                    renderIdeaMarkdown();
                });

                // Show regenerate button
                document.getElementById('btnRegenerateIdea').style.display = 'inline-block';
                updateButtonStates();
            } catch (error) {
                console.error('Idea generation error:', error);
                markdown.innerHTML = '<p class="text-danger">Error generating idea. Please try again.</p>';
            } finally {
                btn.innerHTML = '<i class="fas fa-magic me-1"></i> Generate Idea';
                btn.disabled = false;
            }
        }

        function renderIdeaMarkdown() {
            const markdown = document.getElementById('ideaMarkdown');
            if (typeof marked !== 'undefined') {
                markdown.innerHTML = marked.parse(currentIdea);
                // Process code blocks
                processCodeBlocks(markdown);
                // Highlight code
                if (typeof hljs !== 'undefined') {
                    markdown.querySelectorAll('pre code').forEach((block) => {
                        hljs.highlightElement(block);
                    });
                }
            } else {
                markdown.innerHTML = escapeHtml(currentIdea).replace(/\n/g, '<br>');
            }
        }

        async function regenerateIdea() {
            if (!selectedMemoryA || !selectedMemoryB) return;

            const btn = document.getElementById('btnRegenerateIdea');
            const markdown = document.getElementById('ideaMarkdown');
            const previousIdea = currentIdea;

            btn.innerHTML = '<span class="loading-spinner"></span>';
            btn.disabled = true;
            currentIdea = '';
            markdown.innerHTML = '';

            try {
                const response = await fetch('/api/architecture/generate-idea', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        memory1Id: selectedMemoryA.id,
                        memory2Id: selectedMemoryB.id,
                        previousIdea: previousIdea
                    })
                });

                await streamResponse(response, (content) => {
                    currentIdea += content;
                    renderIdeaMarkdown();
                });

                updateButtonStates();
            } catch (error) {
                console.error('Idea regeneration error:', error);
                currentIdea = previousIdea;
                renderIdeaMarkdown();
            } finally {
                btn.innerHTML = '<i class="fas fa-sync-alt me-1"></i> Regenerate';
                btn.disabled = false;
            }
        }

        async function generateArchitecture() {
            if (!selectedMemoryA || !selectedMemoryB || !currentIdea) return;

            const btnGenerate = document.getElementById('btnGenerateArch');
            const btnStop = document.getElementById('btnStopArch');
            const placeholder = document.getElementById('archPlaceholder');
            const content = document.getElementById('archContent');
            const language = document.getElementById('languageSelect').value;

            btnGenerate.style.display = 'none';
            btnStop.style.display = 'inline-block';
            placeholder.style.display = 'none';
            content.style.display = 'block';
            content.innerHTML = '';
            currentArchitecture = '';
            isGenerating = true;

            abortController = new AbortController();

            try {
                const response = await fetch('/api/architecture/generate-architecture', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        memory1Id: selectedMemoryA.id,
                        memory2Id: selectedMemoryB.id,
                        ideaPrompt: currentIdea,
                        language: language
                    }),
                    signal: abortController.signal
                });

                await streamResponse(response, (chunk) => {
                    currentArchitecture += chunk;
                    renderArchitectureContent(false);  // During streaming
                });

                // Final render with mermaid diagrams
                renderArchitectureContent(true);

                // Show share button
                document.getElementById('shareSection').style.display = 'flex';
            } catch (error) {
                if (error.name === 'AbortError') {
                    console.log('Generation stopped by user');
                } else {
                    console.error('Architecture generation error:', error);
                    content.innerHTML = '<p class="text-danger">Error generating architecture. Please try again.</p>';
                }
            } finally {
                btnGenerate.style.display = 'inline-block';
                btnStop.style.display = 'none';
                isGenerating = false;
                abortController = null;
            }
        }

        function stopGeneration() {
            if (abortController) {
                abortController.abort();
            }
        }

        async function streamResponse(response, onChunk) {
            const reader = response.body.getReader();
            const decoder = new TextDecoder();
            let buffer = '';

            while (true) {
                const { done, value } = await reader.read();
                if (done) break;

                buffer += decoder.decode(value, { stream: true });
                const lines = buffer.split('\n');
                buffer = lines.pop() || '';

                for (const line of lines) {
                    if (line.startsWith('data: ')) {
                        try {
                            const data = JSON.parse(line.substring(6));
                            if (data.content) {
                                onChunk(data.content);
                            }
                        } catch (e) {
                            // Ignore parse errors
                        }
                    }
                }
            }
        }

        function renderArchitectureContent(isFinal = false) {
            const content = document.getElementById('archContent');

            // Render markdown
            if (typeof marked !== 'undefined') {
                content.innerHTML = marked.parse(currentArchitecture);
            } else {
                content.innerHTML = escapeHtml(currentArchitecture).replace(/\n/g, '<br>');
            }

            // Process code blocks (add header with language and copy button)
            processCodeBlocks(content);

            // Highlight code blocks
            if (typeof hljs !== 'undefined') {
                content.querySelectorAll('pre code').forEach((block) => {
                    if (!block.classList.contains('language-mermaid')) {
                        hljs.highlightElement(block);
                    }
                });
            }

            // Only render mermaid diagrams after streaming is complete
            if (isFinal) {
                renderMermaidInContent(content);
            } else {
                // Show placeholder for mermaid during streaming
                content.querySelectorAll('pre > code.language-mermaid').forEach((block) => {
                    const pre = block.parentElement;
                    if (!pre.classList.contains('mermaid-pending')) {
                        pre.classList.add('mermaid-pending');
                        const header = pre.querySelector('.code-block-header');
                        if (header) {
                            header.querySelector('.code-language').textContent = 'MERMAID (렌더링 대기 중...)';
                        }
                    }
                });
            }
        }

        function processCodeBlocks(container) {
            container.querySelectorAll('pre > code').forEach((codeBlock, index) => {
                const pre = codeBlock.parentElement;

                // Skip if already processed
                if (pre.querySelector('.code-block-header')) return;

                // Detect language from class
                let language = 'code';
                const classList = codeBlock.className.split(' ');
                for (const cls of classList) {
                    if (cls.startsWith('language-')) {
                        language = cls.replace('language-', '');
                        break;
                    }
                }

                // Create header
                const header = document.createElement('div');
                header.className = 'code-block-header';
                header.innerHTML = `
                    <span class="code-language">${escapeHtml(language)}</span>
                    <button class="code-copy-btn" onclick="copyCodeBlock(this)" data-index="${index}">
                        <i class="fas fa-copy"></i> Copy
                    </button>
                `;

                pre.insertBefore(header, pre.firstChild);
            });
        }

        function copyCodeBlock(button) {
            const pre = button.closest('pre');
            const code = pre.querySelector('code');
            const text = code.textContent;

            navigator.clipboard.writeText(text).then(() => {
                button.classList.add('copied');
                button.innerHTML = '<i class="fas fa-check"></i> Copied!';

                setTimeout(() => {
                    button.classList.remove('copied');
                    button.innerHTML = '<i class="fas fa-copy"></i> Copy';
                }, 2000);
            }).catch(err => {
                console.error('Copy failed:', err);
            });
        }

        async function renderMermaidInContent(container) {
            if (typeof mermaid === 'undefined') return;

            const mermaidBlocks = container.querySelectorAll('pre > code.language-mermaid');

            for (let i = 0; i < mermaidBlocks.length; i++) {
                const codeBlock = mermaidBlocks[i];
                const pre = codeBlock.parentElement;
                const mermaidCode = codeBlock.textContent.trim();

                // Create mermaid container
                const mermaidContainer = document.createElement('div');
                mermaidContainer.className = 'mermaid-container';

                const mermaidDiv = document.createElement('div');
                mermaidDiv.className = 'mermaid';
                mermaidDiv.textContent = mermaidCode;
                mermaidContainer.appendChild(mermaidDiv);

                pre.parentNode.replaceChild(mermaidContainer, pre);

                try {
                    await mermaid.run({ nodes: [mermaidDiv] });
                } catch (error) {
                    console.error('Mermaid render error:', error);
                    mermaidContainer.innerHTML = `
                        <div class="alert alert-warning mb-0">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            다이어그램 렌더링 실패
                        </div>
                        <details class="mt-2">
                            <summary class="text-muted" style="cursor:pointer;">원본 코드 보기</summary>
                            <pre style="background:#f8f9fa; padding:10px; margin-top:10px; font-size:0.8rem;"><code>${escapeHtml(mermaidCode)}</code></pre>
                        </details>
                    `;
                }
            }
        }

        async function shareArchitecture() {
            if (!currentArchitecture) return;

            try {
                const response = await fetch('/api/architecture/share', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        memory1Id: selectedMemoryA.id,
                        memory2Id: selectedMemoryB.id,
                        memory1Title: selectedMemoryA.title,
                        memory2Title: selectedMemoryB.title,
                        ideaPrompt: currentIdea,
                        architecture: currentArchitecture,
                        language: document.getElementById('languageSelect').value
                    })
                });

                if (!response.ok) throw new Error('Failed to create share link');

                const data = await response.json();
                const shareUrl = `${window.location.origin}/ui/architecture/share/${data.shortCode}`;

                document.getElementById('shareUrlInput').value = shareUrl;
                new bootstrap.Modal(document.getElementById('shareModal')).show();
            } catch (error) {
                console.error('Share error:', error);
                alert('Failed to create share link. Please try again.');
            }
        }

        function copyShareUrl() {
            const input = document.getElementById('shareUrlInput');
            navigator.clipboard.writeText(input.value).then(() => {
                const success = document.getElementById('copySuccess');
                success.classList.remove('d-none');
                setTimeout(() => success.classList.add('d-none'), 3000);
            });
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function truncateText(text, maxLength) {
            if (!text) return '';
            if (text.length <= maxLength) return text;
            return text.substring(0, maxLength) + '...';
        }
    </script>
}
