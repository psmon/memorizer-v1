@using Memorizer.Services
@inject ICustomScriptService CustomScriptService
@{
    var isAuthenticated = Context.Items["IsAuthenticated"] as bool? ?? false;
    var username = Context.Items["Username"] as string ?? "";
    var customScripts = await CustomScriptService.GetActiveScriptsAsync();
    var currentController = ViewBag.Controller as string ?? ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Memorizer</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet">
    <link href="~/css/tools.css" rel="stylesheet">
    <link href="~/css/markdown-styles.css" rel="stylesheet">
    @await RenderSectionAsync("Styles", required: false)
    <!-- Custom script -->
    @if (!string.IsNullOrWhiteSpace(customScripts))
    {
        @Html.Raw(customScripts)
    }
</head>
<body>
    <!-- Hamburger menu button fixed position -->
    <button class="hamburger-menu" type="button" onclick="toggleSidebar()">
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
    </button>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav id="sidebarMenu" class="sidebar-container" tabindex="-1">
                <div class="sidebar-inner">
                    <div class="sidebar-content">
                        <div class="text-center mb-4">
                            <h4 class="text-white">
                                <i class="fas fa-brain me-2"></i>
                                Memorizer
                            </h4>
                            <p class="text-white-50 small">Memory Management System</p>
                        </div>
                    
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">
                                <i class="fas fa-list me-2"></i>
                                All Memories
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Blog" ? "active" : "")"
                               href="/ui/blog">
                                <i class="fas fa-blog me-2"></i>
                                Blog Memories
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "GraphView" ? "active" : "")"
                               href="/ui/graph">
                                <i class="fas fa-project-diagram me-2"></i>
                                Graph View
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "AskBotView" ? "active" : "")"
                               href="/ui/askbot">
                                <i class="fas fa-robot me-2"></i>
                                ASK Bot
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "ShareListView" ? "active" : "")"
                               href="/ui/sharelist">
                                <i class="fas fa-brain me-2"></i>
                                AI-Knowledges
                            </a>
                        </li>
                        @if (isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")"
                                   asp-controller="Home" asp-action="Create">
                                    <i class="fas fa-plus me-2"></i>
                                    Create Memory
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Tools" ? "active" : "")"
                                   asp-controller="Tools" asp-action="Index">
                                    <i class="fas fa-tools me-2"></i>
                                    Tools
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Stats" ? "active" : "")"
                                   asp-controller="Home" asp-action="Stats">
                                    <i class="fas fa-chart-bar me-2"></i>
                                    Statistics
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "McpConfig" ? "active" : "")"
                                   asp-controller="Home" asp-action="McpConfig">
                                    <i class="fas fa-cog me-2"></i>
                                    MCP Config
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Config" ? "active" : "")"
                                   asp-controller="Home" asp-action="Config">
                                    <i class="fas fa-cogs me-2"></i>
                                    System Config
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "ScriptConfig" ? "active" : "")"
                                   asp-controller="Home" asp-action="ScriptConfig">
                                    <i class="fas fa-code me-2"></i>
                                    Script Config
                                </a>
                            </li>
                        }
                    </ul>
                    
                    <hr class="my-4" style="border-color: rgba(255, 255, 255, 0.3);">
                    
                    @if (isAuthenticated)
                    {
                        <div class="text-center mb-3">
                            <small class="text-white-50">
                                <i class="fas fa-user me-1"></i>
                                Logged in as: <strong>@username</strong>
                            </small>
                            <br>
                            <a href="/logout" class="btn btn-sm btn-outline-light mt-2">
                                <i class="fas fa-sign-out-alt me-1"></i>
                                Logout
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center mb-3">
                            <a href="/auth/login" class="btn btn-sm btn-outline-light">
                                <i class="fas fa-sign-in-alt me-1"></i>
                                Login
                            </a>
                        </div>
                    }
                    
                    <div class="text-center">
                        <small class="text-white-50">
                            <i class="fas fa-database me-1"></i>
                            PostgreSQL + pgvector
                            <br>
                            <i class="fas fa-project-diagram me-1"></i>
                            Neo4j Graph
                        </small>
                        </div>
                    </div>
                </div>
            </nav>

            <!-- Main content -->
            <main class="main-content">
                <div class="content-wrapper-inner">
                    @RenderBody()
                </div>
                
                <!-- Footer with attribution -->
                <footer class="mt-auto py-3 border-top">
                    <div class="text-center">
                        <div class="mb-1">
                            <small class="text-muted">
                                Made with ❤️ by <a href="https://wiki.webnori.com/display/AKKA/Vibe+Coding+Actor+Model/" target="_blank" class="text-decoration-none">psmon</a>
                            </small>
                        </div>
                        <div class="mb-2">
                            <small class="text-muted">
                                originally forked from <a href="https://github.com/Aaronontheweb/memorizer-v1/" target="_blank" class="text-decoration-none">Aaronontheweb</a>'s <a href="https://petabridge.com/" target="_blank" class="text-decoration-none"><code>pertabridge</code></a> server
                            </small>
                        </div>
                        <div>
                            <small class="text-muted">
                                <a href="https://github.com/psmon/memorizer-v1">Memorizer</a> v@(System.Reflection.Assembly.GetExecutingAssembly().GetName().Version?.ToString() ?? "Unknown")
                            </small>
                        </div>
                    </div>
                </footer>
            </main>
        </div>
    </div>

    <!-- jQuery (required by many components) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    
    <!-- Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Prism for code highlighting -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-core.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js"></script>
    
    <!-- SVG Pan Zoom library for mermaid diagram controls -->
    <script src="https://cdn.jsdelivr.net/npm/svg-pan-zoom@3.6.1/dist/svg-pan-zoom.min.js"></script>
    
    <!-- Custom scripts -->
    <script src="~/js/memory-utils.js"></script>
    <script src="~/js/markdown-renderer.js"></script>

    <script>
        let sidebarOpen = true;

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebarMenu');
            const mainContent = document.querySelector('.main-content');
            const hamburger = document.querySelector('.hamburger-menu');

            sidebarOpen = !sidebarOpen;

            if (sidebarOpen) {
                sidebar.classList.remove('collapsed');
                mainContent.classList.remove('expanded');
                hamburger.classList.add('active'); // X icon when menu is open
            } else {
                sidebar.classList.add('collapsed');
                mainContent.classList.add('expanded');
                hamburger.classList.remove('active'); // Hamburger icon when menu is closed
            }
        }

        function checkScreenSize() {
            const sidebar = document.getElementById('sidebarMenu');
            const mainContent = document.querySelector('.main-content');
            const hamburger = document.querySelector('.hamburger-menu');
            const width = window.innerWidth;

            // Auto-collapse on narrow screens
            if (width <= 768 && sidebarOpen) {
                sidebarOpen = false;
                sidebar.classList.add('collapsed');
                mainContent.classList.add('expanded');
                hamburger.classList.remove('active'); // Hamburger when collapsed
            } else if (width > 768 && !sidebarOpen) {
                // Auto-expand on wider screens
                sidebarOpen = true;
                sidebar.classList.remove('collapsed');
                mainContent.classList.remove('expanded');
                hamburger.classList.add('active'); // X when expanded
            }
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            checkScreenSize();
            // Set initial hamburger state
            const hamburger = document.querySelector('.hamburger-menu');
            if (sidebarOpen) {
                hamburger.classList.add('active'); // X icon if menu is initially open
            }
        });

        // Check on window resize
        window.addEventListener('resize', function() {
            checkScreenSize();
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html> 