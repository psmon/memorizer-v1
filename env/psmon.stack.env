# Scenario: psmon local development (replaces the old docker-compose.local-psmon.yml)
#   cp env/psmon.stack.env .env        # then fill in the API keys in .env only
#   docker compose up -d --build --no-deps memorizer   # rebuild app only, keep DBs running
#
# Custom LM Studio devices (token auth), 768-dim embeddings (DB already migrated to 768),
# LLM = gemma-4-e4b (fast), LLM-EX = gemma-4-26b-a4b (advanced reasoning),
# Headless WebSearch with Playwright, app on port 5012.

LLM_PRESET=custom
COMPOSE_PROFILES=

MEMORIZER_IMAGE=psmon/mcp-memorizer:latest
MEMORIZER_PORT=5012
MEMORIZER_RUN_AS=0:0
CANONICAL_URL=http://localhost:5012

WEBSEARCH_MODE=Headless
WEBSEARCH_INSTALL_BROWSER=true
WEBSEARCH_INSTALL_LINUX_DEPS=true

# ── LLM devices — API keys go in your .env copy only (this template is committed) ──
LLM_A_URL=https://a1.webnori.com
LLM_A_API_KEY=
LLM_B_URL=https://a2.webnori.com
LLM_B_API_KEY=

# Feature → device routing (default: every feature uses device A)
# MultiModal → device B (vision: qwen/qwen3.8-27b)
MULTIMODAL_URL=${LLM_B_URL}
MULTIMODAL_API_KEY=${LLM_B_API_KEY}

CUSTOM_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
CUSTOM_LLM_MODEL=google/gemma-4-e4b
CUSTOM_LLM_EX_MODEL=google/gemma-4-26b-a4b
CUSTOM_MULTIMODAL_MODEL=qwen/qwen3.8-27b

POSTGRES_PASSWORD=postgres
NEO4J_PASSWORD=password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
MEMORIZER_API_KEY=your-api-key-here
OAUTH_ENABLED=true
OAUTH_SECRET_KEY=your-super-secret-key-at-least-32-characters-long
OAUTH_CLIENT_ID=chatgpt-mcp
OAUTH_CLIENT_SECRET=chatgpt-secret-key
