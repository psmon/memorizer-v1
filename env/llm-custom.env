# LLM preset: Custom (LM Studio / OpenAI-compatible servers)
# Select with LLM_PRESET=custom in .env (Ollama profile not needed)
#
# Two LLM devices are supported. Every feature uses device A unless routed in .env:
#   LLM_A_URL / LLM_A_API_KEY   — default device (https://a1.webnori.com)
#   LLM_B_URL / LLM_B_API_KEY   — second device
# Route a feature to device B in .env, e.g.
#   MULTIMODAL_URL=${LLM_B_URL}
#   MULTIMODAL_API_KEY=${LLM_B_API_KEY}
# Feature keys: EMBEDDING_*, LLM_*, LLM_EX_*, MULTIMODAL_*  (URL / API_KEY)
# API keys are sent as OpenAI-style Bearer tokens. Never put them in this file.

# Embeddings
#   text-embedding-all-minilm-l12-v2      → 384 dims (default DB schema)
#   text-embedding-nomic-embed-text-v1.5  → 768 dims (requires the manual 768 migration — see src/Memorizer/migrations/embedding_dimension.md)
MEMORIZER_Embeddings__Type=Custom
MEMORIZER_Embeddings__ApiUrl=${EMBEDDING_URL:-${LLM_A_URL:-https://a1.webnori.com}}
MEMORIZER_Embeddings__ApiKey=${EMBEDDING_API_KEY-${LLM_A_API_KEY:-}}
MEMORIZER_Embeddings__Model=${CUSTOM_EMBEDDING_MODEL:-text-embedding-all-minilm-l12-v2}

# LLM — fast default model
MEMORIZER_LLM__Type=Custom
MEMORIZER_LLM__ApiUrl=${LLM_URL:-${LLM_A_URL:-https://a1.webnori.com}}
MEMORIZER_LLM__ApiKey=${LLM_API_KEY-${LLM_A_API_KEY:-}}
MEMORIZER_LLM__Model=${CUSTOM_LLM_MODEL:-google/gemma-4-e4b}
MEMORIZER_LLM__Timeout=00:02:00

# LLM-EX — advanced reasoning model (PRD Maker, ShapeUp, AskBot LLM-EX)
MEMORIZER_LLM-EX__Type=Custom
MEMORIZER_LLM-EX__ApiUrl=${LLM_EX_URL:-${LLM_A_URL:-https://a1.webnori.com}}
MEMORIZER_LLM-EX__ApiKey=${LLM_EX_API_KEY-${LLM_A_API_KEY:-}}
MEMORIZER_LLM-EX__Model=${CUSTOM_LLM_EX_MODEL:-google/gemma-4-26b-a4b}
MEMORIZER_LLM-EX__Timeout=00:05:00

# MultiModal (vision)
MEMORIZER_MultiModal__Type=Custom
MEMORIZER_MultiModal__ApiUrl=${MULTIMODAL_URL:-${LLM_A_URL:-https://a1.webnori.com}}
MEMORIZER_MultiModal__ApiKey=${MULTIMODAL_API_KEY-${LLM_A_API_KEY:-}}
MEMORIZER_MultiModal__Model=${CUSTOM_MULTIMODAL_MODEL:-qwen/qwen3-vl-8b}
MEMORIZER_MultiModal__Temperature=0.2
MEMORIZER_MultiModal__MaxTokens=4096
MEMORIZER_MultiModal__Timeout=00:02:00
