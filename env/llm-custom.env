# LLM preset: Custom (LM Studio / OpenAI-compatible server on the internal network)
# Select with LLM_PRESET=custom in .env (Ollama profile not needed)
# LM Studio API token: set CUSTOM_LLM_API_KEY in .env (never in this file) — sent as OpenAI-style Bearer token
# Values may reference .env variables with ${VAR:-default}.

# Embeddings
#   text-embedding-all-minilm-l12-v2      → 384 dims (default DB schema)
#   text-embedding-nomic-embed-text-v1.5  → 768 dims (requires the manual 768 migration — see src/Memorizer/migrations/embedding_dimension.md)
MEMORIZER_Embeddings__Type=Custom
MEMORIZER_Embeddings__ApiUrl=${CUSTOM_LLM_URL:-http://192.168.0.50:1234}
MEMORIZER_Embeddings__Model=${CUSTOM_EMBEDDING_MODEL:-text-embedding-all-minilm-l12-v2}
MEMORIZER_Embeddings__ApiKey=${CUSTOM_LLM_API_KEY:-}

# LLM — fast default model
MEMORIZER_LLM__Type=Custom
MEMORIZER_LLM__ApiUrl=${CUSTOM_LLM_URL:-http://192.168.0.50:1234}
MEMORIZER_LLM__Model=${CUSTOM_LLM_MODEL:-google/gemma-4-e4b}
MEMORIZER_LLM__Timeout=00:02:00
MEMORIZER_LLM__ApiKey=${CUSTOM_LLM_API_KEY:-}

# LLM-EX — advanced reasoning model (PRD Maker, ShapeUp, AskBot LLM-EX)
MEMORIZER_LLM-EX__Type=Custom
MEMORIZER_LLM-EX__ApiUrl=${CUSTOM_LLM_EX_URL:-${CUSTOM_LLM_URL:-http://192.168.0.50:1234}}
MEMORIZER_LLM-EX__Model=${CUSTOM_LLM_EX_MODEL:-google/gemma-4-26b-a4b}
MEMORIZER_LLM-EX__Timeout=00:05:00
MEMORIZER_LLM-EX__ApiKey=${CUSTOM_LLM_API_KEY:-}

# MultiModal (vision)
MEMORIZER_MultiModal__Type=Custom
MEMORIZER_MultiModal__ApiUrl=${CUSTOM_LLM_URL:-http://192.168.0.50:1234}
MEMORIZER_MultiModal__Model=${CUSTOM_MULTIMODAL_MODEL:-qwen/qwen3-vl-8b}
MEMORIZER_MultiModal__Temperature=0.2
MEMORIZER_MultiModal__MaxTokens=4096
MEMORIZER_MultiModal__Timeout=00:02:00
MEMORIZER_MultiModal__ApiKey=${CUSTOM_LLM_API_KEY:-}
