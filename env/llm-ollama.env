# LLM preset: Ollama (all-in-one local)
# Select with LLM_PRESET=ollama and COMPOSE_PROFILES=ollama in .env
# Values may reference .env variables with ${VAR:-default}.

# Embeddings — all-minilm = 384 dims (matches the default DB schema)
MEMORIZER_Embeddings__Type=Ollama
MEMORIZER_Embeddings__ApiUrl=${OLLAMA_URL:-http://ollama:11434}
MEMORIZER_Embeddings__Model=${OLLAMA_EMBEDDING_MODEL:-all-minilm:33m-l12-v2-fp16}

# LLM
MEMORIZER_LLM__Type=Ollama
MEMORIZER_LLM__ApiUrl=${OLLAMA_URL:-http://ollama:11434}
MEMORIZER_LLM__Model=${OLLAMA_LLM_MODEL:-qwen2:0.5b}
MEMORIZER_LLM__Timeout=00:02:00

# LLM-EX (deep analysis: PRD Maker, ShapeUp, ...)
MEMORIZER_LLM-EX__Type=Ollama
MEMORIZER_LLM-EX__ApiUrl=${OLLAMA_URL:-http://ollama:11434}
MEMORIZER_LLM-EX__Model=${OLLAMA_LLM_EX_MODEL:-${OLLAMA_LLM_MODEL:-qwen2:0.5b}}
MEMORIZER_LLM-EX__Timeout=00:05:00

# MultiModal — not supported by Ollama provider (Custom/OpenAI only).
# To enable image features, set MEMORIZER_MultiModal__* in env/local.override.env.
