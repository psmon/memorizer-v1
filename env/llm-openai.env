# LLM preset: OpenAI (cloud)
# Select with LLM_PRESET=openai in .env and set OPENAI_API_KEY there (never in this file).
# Values may reference .env variables with ${VAR:-default}.

# Embeddings — text-embedding-3-small = 1536 dims; the default DB schema is 384 dims,
# so the vector columns must be migrated before using this preset on a fresh database.
MEMORIZER_Embeddings__Type=OpenAI
MEMORIZER_Embeddings__ApiUrl=api.openai.com
MEMORIZER_Embeddings__Model=${OPENAI_EMBEDDING_MODEL:-text-embedding-3-small}
MEMORIZER_Embeddings__ApiKey=${OPENAI_API_KEY}

# LLM
MEMORIZER_LLM__Type=OpenAI
MEMORIZER_LLM__ApiUrl=api.openai.com
MEMORIZER_LLM__Model=${OPENAI_LLM_MODEL:-gpt-4o}
MEMORIZER_LLM__Timeout=00:02:00
MEMORIZER_LLM__ApiKey=${OPENAI_API_KEY}

# LLM-EX (deep analysis: PRD Maker, ShapeUp, ...)
MEMORIZER_LLM-EX__Type=OpenAI
MEMORIZER_LLM-EX__Model=${OPENAI_LLM_EX_MODEL:-gpt-4o}
MEMORIZER_LLM-EX__Timeout=00:05:00
MEMORIZER_LLM-EX__ApiKey=${OPENAI_API_KEY}

# MultiModal (vision)
MEMORIZER_MultiModal__Type=OpenAI
MEMORIZER_MultiModal__Model=${OPENAI_MULTIMODAL_MODEL:-gpt-4o}
MEMORIZER_MultiModal__Temperature=0.2
MEMORIZER_MultiModal__MaxTokens=4096
MEMORIZER_MultiModal__Timeout=00:02:00
MEMORIZER_MultiModal__ApiKey=${OPENAI_API_KEY}
